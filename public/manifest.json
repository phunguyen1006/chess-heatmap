{
  "manifest_version": 3,
  "name": "Chess.com Activity Heatmap",
  "version": "1.0.0",
  "description": "Interactive GitHub-style annual activity heatmap directly on your Chess.com homepage.",
  "permissions": ["storage"],
  "minimum_chrome_version": "116",
  "host_permissions": ["https://www.chess.com/*", "https://api.chess.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
